{
  "_comment": "The machine-readable export boundary: every path downstream projects consume, grouped by HOW it reaches them (which determines how changes propagate). Validated by .github/scripts/check-exports.js in qa.yml: every path must exist, and every raw-URL self-reference in the tree must point inside one of these paths. Anything not listed here is internal to this repo and safe to move.",
  "categories": {
    "inherited-rules": {
      "mode": "fetched live by raw URL at session start — changes propagate immediately",
      "paths": [
        "directives/global.md",
        "directives/git.md",
        "directives/design.md",
        "directives/test.md",
        "directives/data.md"
      ]
    },
    "installed-tooling": {
      "mode": "installed via the plugin marketplace / env setup script — propagates on env cache rebuild (~weekly), versioned by git SHA",
      "paths": [
        ".claude-plugin/marketplace.json",
        "plugins/directives-toolkit/",
        "scripts/install-toolkit.sh"
      ]
    },
    "copied-scaffolding": {
      "mode": "copied into projects at bootstrap — snapshots that drift by design; /refresh-repo detects drift",
      "paths": [
        "templates/"
      ]
    },
    "referenced-docs": {
      "mode": "read on demand via links — no copy, no install",
      "paths": [
        "docs/standards/",
        "docs/guides/",
        "NEW-REPO-USER-INSTRUCTIONS.md",
        "MAINTAIN-REPO-USER-INSTRUCTIONS.md"
      ]
    }
  },
  "domains": {
    "_comment": "The LOGICAL view, orthogonal to categories (which encode propagation): which files constitute each swappable paradigm. To swap a paradigm, replace its tagged set across all delivery modes at once — see MAINTAIN-REPO-USER-INSTRUCTIONS.md → Domain Boundaries. 'meta' is the delivery machinery itself and is not swappable. Validated by check-exports.js: every path must exist.",
    "global": [
      "directives/global.md",
      "templates/CLAUDE-template.md",
      "templates/nextjs-app/",
      "templates/actions/secret-scan/",
      "templates/workflows/pages-monitor.yml",
      "templates/workflows/pages-retry.yml",
      "plugins/directives-toolkit/skills/update-pages/",
      "plugins/directives-toolkit/commands/diagnose.md",
      "plugins/directives-toolkit/commands/kickoff.md",
      "plugins/directives-toolkit/commands/sdd-loop.md",
      "plugins/directives-toolkit/commands/learn.md",
      "docs/guides/ai-first-principles.md",
      "docs/guides/dev-pipeline.md",
      "docs/guides/usage-guide.md"
    ],
    "git": [
      "directives/git.md",
      "templates/pr-checklist.md",
      "templates/workflows/ci-monitor.yml",
      "templates/workflows/ci-notify.yml",
      "templates/workflows/codex-monitor.yml",
      "templates/workflows/keepalive.yml",
      "templates/workflows/cron-notify.yml",
      "templates/scripts/notify-email.js",
      "templates/scripts/notify-task.js",
      "templates/scripts/package.json",
      "plugins/directives-toolkit/commands/commit-chk.md",
      "docs/standards/automations.md",
      "docs/standards/cicd-setup.md",
      "docs/guides/cron-email-notifications.md"
    ],
    "design": [
      "directives/design.md",
      "templates/styles/",
      "templates/scripts/check-contrast.js",
      "plugins/directives-toolkit/commands/design-intake.md",
      "docs/guides/design-tooling.md"
    ],
    "test": [
      "directives/test.md",
      "templates/workflows/qa.yml",
      "templates/workflows/qa-live.yml",
      "templates/workflows/qa-response.yml",
      "templates/actions/ui-suite/",
      "templates/ui-tests/",
      "templates/project-test-plan-template.md",
      "templates/implementation-summary-template.md",
      "plugins/directives-toolkit/agents/test-verifier.md",
      "plugins/directives-toolkit/agents/ui-tester.md",
      "plugins/directives-toolkit/agents/qa-pipeline.md",
      "plugins/directives-toolkit/agents/pr-readiness-reviewer.md",
      "docs/standards/ci-triage.md",
      "docs/standards/code-review-standard.md"
    ],
    "data": [
      "directives/data.md",
      "plugins/directives-toolkit/agents/supabase.md"
    ],
    "meta": [
      ".claude-plugin/marketplace.json",
      "scripts/install-toolkit.sh",
      "templates/claude-settings.json",
      "plugins/directives-toolkit/.claude-plugin/plugin.json",
      "plugins/directives-toolkit/commands/new-repo.md",
      "plugins/directives-toolkit/commands/refresh-repo.md",
      "plugins/directives-toolkit/commands/env-chk.md",
      "plugins/directives-toolkit/commands/audit-repo.md",
      "plugins/directives-toolkit/commands/handoff-session.md",
      "plugins/directives-toolkit/commands/do-repo.md",
      "plugins/directives-toolkit/commands/my-list.md",
      "plugins/directives-toolkit/skills/scope-chk/",
      "plugins/directives-toolkit/skills/doc-comp/",
      "plugins/directives-toolkit/hooks/",
      "plugins/directives-toolkit/scripts/",
      "NEW-REPO-USER-INSTRUCTIONS.md",
      "MAINTAIN-REPO-USER-INSTRUCTIONS.md"
    ]
  }
}
