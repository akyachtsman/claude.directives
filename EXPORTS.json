{
  "_comment": "The machine-readable export boundary: every path downstream projects consume, grouped by HOW it reaches them (which determines how changes propagate). Validated by .github/scripts/check-exports.js in qa.yml: every path must exist, and every raw-URL self-reference in the tree must point inside one of these paths. Anything not listed here is internal to this repo and safe to move.",
  "categories": {
    "inherited-rules": {
      "mode": "fetched live by raw URL at session start — changes propagate immediately",
      "paths": [
        "directives/global.md",
        "directives/git.md",
        "directives/design.md",
        "directives/test.md",
        "directives/data.md"
      ]
    },
    "installed-tooling": {
      "mode": "installed via the plugin marketplace / env setup script — propagates on env cache rebuild (~weekly), versioned by git SHA",
      "paths": [
        ".claude-plugin/marketplace.json",
        "plugins/directives-toolkit/",
        "scripts/install-toolkit.sh"
      ]
    },
    "copied-scaffolding": {
      "mode": "copied into projects at bootstrap — snapshots that drift by design; /refresh-repo detects drift",
      "paths": [
        "templates/"
      ]
    },
    "referenced-docs": {
      "mode": "read on demand via links — no copy, no install",
      "paths": [
        "docs/standards/",
        "docs/guides/",
        "NEW-REPO-USER-INSTRUCTIONS.md",
        "MAINTAIN-REPO-USER-INSTRUCTIONS.md"
      ]
    }
  },
  "domains": {
    "_comment": "The LOGICAL view, orthogonal to categories (which encode propagation): domain → compartment → paths. A compartment is the swappable unit — replace its file set honoring its interface and nothing outside it moves. Rendered visually at docs/site/logical-map.html; boundaries and swap procedure in MAINTAIN-REPO-USER-INSTRUCTIONS.md → Domain Boundaries. Validated by check-exports.js: every path must exist.",
    "global": {
      "core": [
        "directives/global.md"
      ],
      "method": [
        "plugins/directives-toolkit/commands/sdd-loop.md",
        "plugins/directives-toolkit/commands/diagnose.md",
        "plugins/directives-toolkit/commands/kickoff.md",
        "plugins/directives-toolkit/commands/learn.md",
        "docs/guides/ai-first-principles.md",
        "docs/guides/dev-pipeline.md",
        "docs/guides/usage-guide.md"
      ],
      "security": [
        "templates/actions/secret-scan/"
      ],
      "deploy": [
        "plugins/directives-toolkit/skills/update-pages/",
        "templates/workflows/pages-monitor.yml",
        "templates/workflows/pages-retry.yml"
      ],
      "starter": [
        "templates/CLAUDE-template.md",
        "templates/nextjs-app/"
      ]
    },
    "git": {
      "lifecycle": [
        "directives/git.md",
        "templates/pr-checklist.md",
        "plugins/directives-toolkit/commands/commit-chk.md"
      ],
      "monitors": [
        "templates/workflows/ci-monitor.yml",
        "templates/workflows/ci-notify.yml",
        "templates/workflows/codex-monitor.yml"
      ],
      "automation": [
        "templates/workflows/keepalive.yml",
        "templates/workflows/cron-notify.yml",
        "templates/scripts/notify-email.js",
        "templates/scripts/notify-task.js",
        "templates/scripts/package.json",
        "docs/guides/cron-email-notifications.md"
      ],
      "setup": [
        "docs/standards/automations.md",
        "docs/standards/cicd-setup.md"
      ]
    },
    "design": {
      "method": [
        "directives/design.md",
        "plugins/directives-toolkit/commands/design-intake.md",
        "docs/guides/design-tooling.md"
      ],
      "contract": [
        "templates/styles/"
      ],
      "guards": [
        "templates/scripts/check-contrast.js"
      ]
    },
    "test": {
      "core": [
        "directives/test.md",
        "plugins/directives-toolkit/agents/qa-pipeline.md"
      ],
      "static-ci": [
        "templates/workflows/qa.yml",
        "templates/workflows/qa-response.yml"
      ],
      "ui-kit": [
        "templates/actions/ui-suite/",
        "templates/ui-tests/",
        "plugins/directives-toolkit/agents/ui-tester.md"
      ],
      "live": [
        "templates/workflows/qa-live.yml"
      ],
      "review": [
        "docs/standards/code-review-standard.md",
        "templates/implementation-summary-template.md"
      ],
      "verify": [
        "plugins/directives-toolkit/agents/test-verifier.md",
        "plugins/directives-toolkit/agents/pr-readiness-reviewer.md",
        "templates/project-test-plan-template.md"
      ],
      "triage": [
        "docs/standards/ci-triage.md"
      ]
    },
    "data": {
      "core": [
        "directives/data.md",
        "plugins/directives-toolkit/agents/supabase.md"
      ]
    },
    "meta": {
      "delivery": [
        ".claude-plugin/marketplace.json",
        "plugins/directives-toolkit/.claude-plugin/plugin.json",
        "scripts/install-toolkit.sh",
        "templates/claude-settings.json",
        "templates/claude-hooks/session-start.sh"
      ],
      "session": [
        "plugins/directives-toolkit/commands/env-chk.md",
        "plugins/directives-toolkit/commands/refresh-repo.md",
        "plugins/directives-toolkit/commands/new-repo.md",
        "plugins/directives-toolkit/commands/audit-repo.md",
        "plugins/directives-toolkit/commands/handoff-session.md",
        "plugins/directives-toolkit/commands/do-repo.md",
        "plugins/directives-toolkit/commands/my-list.md",
        "plugins/directives-toolkit/skills/scope-chk/",
        "plugins/directives-toolkit/skills/doc-comp/"
      ],
      "guards": [
        "plugins/directives-toolkit/hooks/",
        "plugins/directives-toolkit/scripts/"
      ],
      "runbooks": [
        "NEW-REPO-USER-INSTRUCTIONS.md",
        "MAINTAIN-REPO-USER-INSTRUCTIONS.md"
      ]
    }
  },
  "swap": {
    "_comment": "Swap classes over the domain view. PERMANENT paths evolve via PR and are never wholesale-replaced — this covers directives/ and the exported standards under docs/standards/, since both carry blocking criteria; the meta domain is permanent in its entirety. ORCHESTRATORS are permanent AND define the flow/interfaces their components must fit — a new component does not exist until its orchestrator sequences it. Everything else is swappable within its compartment's interface.",
    "permanent": [
      "directives/global.md",
      "directives/git.md",
      "directives/test.md",
      "directives/data.md",
      "docs/standards/code-review-standard.md",
      "docs/standards/ci-triage.md"
    ],
    "orchestrators": [
      "plugins/directives-toolkit/commands/sdd-loop.md",
      "plugins/directives-toolkit/agents/qa-pipeline.md"
    ]
  },
  "classes": {
    "_comment": "Durability classes over the exported set — WHAT KIND of thing each file is, and therefore what happens to it as models improve. Independent of `swap` (which says whether a path may be replaced) and of `domains` (which says what it belongs to). Every path in `domains` must appear in exactly one class; check-exports.js enforces the partition, so this view cannot rot the way an unchecked diagram would. Drawn at docs/site/logical-map.html, which build-logical-map.js generates from this file.",
    "standard": {
      "label": "Standards",
      "blurb": "State blocking criteria a change must satisfy. Model-independent: a smarter model still has to meet them.",
      "paths": [
        "directives/global.md",
        "directives/git.md",
        "docs/standards/automations.md",
        "docs/standards/cicd-setup.md",
        "directives/design.md",
        "directives/test.md",
        "docs/standards/code-review-standard.md",
        "docs/standards/ci-triage.md",
        "directives/data.md"
      ]
    },
    "orchestrator": {
      "label": "Orchestrators",
      "blurb": "Define the flow and the interfaces components must fit. A component does not exist until its orchestrator sequences it.",
      "paths": [
        "plugins/directives-toolkit/commands/sdd-loop.md",
        "plugins/directives-toolkit/agents/qa-pipeline.md"
      ]
    },
    "behavioral": {
      "label": "Behavioral scaffolding",
      "blurb": "Tells a model HOW to act. The only class that decays as models improve — audit it whenever the model tier changes.",
      "paths": [
        "plugins/directives-toolkit/commands/diagnose.md",
        "plugins/directives-toolkit/commands/kickoff.md",
        "plugins/directives-toolkit/commands/learn.md",
        "plugins/directives-toolkit/skills/update-pages/",
        "plugins/directives-toolkit/commands/commit-chk.md",
        "plugins/directives-toolkit/commands/design-intake.md",
        "plugins/directives-toolkit/agents/ui-tester.md",
        "plugins/directives-toolkit/agents/test-verifier.md",
        "plugins/directives-toolkit/agents/pr-readiness-reviewer.md",
        "plugins/directives-toolkit/agents/supabase.md",
        "plugins/directives-toolkit/commands/env-chk.md",
        "plugins/directives-toolkit/commands/refresh-repo.md",
        "plugins/directives-toolkit/commands/new-repo.md",
        "plugins/directives-toolkit/commands/audit-repo.md",
        "plugins/directives-toolkit/commands/handoff-session.md",
        "plugins/directives-toolkit/commands/do-repo.md",
        "plugins/directives-toolkit/commands/my-list.md",
        "plugins/directives-toolkit/skills/scope-chk/",
        "plugins/directives-toolkit/skills/doc-comp/"
      ]
    },
    "mechanical": {
      "label": "Mechanical enforcement",
      "blurb": "Runs with no model in the loop. Immune to model change; the backstop when scaffolding is trimmed.",
      "paths": [
        "templates/actions/secret-scan/",
        "templates/workflows/pages-monitor.yml",
        "templates/workflows/pages-retry.yml",
        "templates/workflows/ci-monitor.yml",
        "templates/workflows/ci-notify.yml",
        "templates/workflows/codex-monitor.yml",
        "templates/workflows/keepalive.yml",
        "templates/workflows/cron-notify.yml",
        "templates/scripts/notify-email.js",
        "templates/scripts/notify-task.js",
        "templates/scripts/package.json",
        "templates/scripts/check-contrast.js",
        "templates/workflows/qa.yml",
        "templates/workflows/qa-response.yml",
        "templates/actions/ui-suite/",
        "templates/ui-tests/",
        "templates/workflows/qa-live.yml",
        ".claude-plugin/marketplace.json",
        "plugins/directives-toolkit/.claude-plugin/plugin.json",
        "scripts/install-toolkit.sh",
        "templates/claude-settings.json",
        "plugins/directives-toolkit/hooks/",
        "plugins/directives-toolkit/scripts/",
        "templates/claude-hooks/session-start.sh"
      ]
    },
    "artifact": {
      "label": "Artifacts",
      "blurb": "Fill-in templates and scaffolds. Consumed by a project, never executed here.",
      "paths": [
        "templates/CLAUDE-template.md",
        "templates/nextjs-app/",
        "templates/pr-checklist.md",
        "templates/styles/",
        "templates/implementation-summary-template.md",
        "templates/project-test-plan-template.md"
      ]
    },
    "reference": {
      "label": "Reference",
      "blurb": "Read on demand. Explains and illustrates; binds nothing on its own.",
      "paths": [
        "docs/guides/ai-first-principles.md",
        "docs/guides/dev-pipeline.md",
        "docs/guides/usage-guide.md",
        "docs/guides/cron-email-notifications.md",
        "docs/guides/design-tooling.md",
        "NEW-REPO-USER-INSTRUCTIONS.md",
        "MAINTAIN-REPO-USER-INSTRUCTIONS.md"
      ]
    }
  },
  "externals": {
    "_comment": "Vendor-owned capabilities this system depends on but does not contain — we hold only the sockets. To swap a vendor: rewire the listed socket files, never fork the vendor's code. serves = domain.compartment from the domains view. sockets = the files here that name/enable/configure it (must exist; validated).",
    "pr-review-toolkit": {
      "vendor": "Anthropic",
      "serves": "test.review",
      "sockets": [
        "scripts/install-toolkit.sh",
        "templates/claude-settings.json",
        "directives/test.md"
      ]
    },
    "code-review-builtin": {
      "vendor": "Anthropic",
      "serves": "test.review",
      "sockets": [
        "directives/test.md"
      ]
    },
    "security-guidance": {
      "vendor": "Anthropic",
      "serves": "global.security",
      "sockets": [
        "scripts/install-toolkit.sh",
        "templates/claude-settings.json",
        "directives/test.md"
      ]
    },
    "security-review-builtin": {
      "vendor": "Anthropic",
      "serves": "global.security",
      "sockets": [
        "directives/test.md"
      ]
    },
    "codex-reviews": {
      "vendor": "GitHub",
      "serves": "git.monitors",
      "sockets": [
        "templates/workflows/codex-monitor.yml",
        "directives/git.md"
      ]
    },
    "github-mcp": {
      "vendor": "GitHub",
      "serves": "git.lifecycle",
      "sockets": [
        "directives/git.md"
      ]
    },
    "playwright": {
      "vendor": "Microsoft",
      "serves": "test.ui-kit",
      "sockets": [
        "templates/ui-tests/package.json",
        "templates/actions/ui-suite/action.yml"
      ]
    },
    "frontend-design": {
      "vendor": "Anthropic",
      "serves": "design.method",
      "sockets": [
        "scripts/install-toolkit.sh",
        "templates/claude-settings.json",
        "docs/guides/design-tooling.md"
      ]
    },
    "stitch": {
      "vendor": "Google",
      "serves": "design.method",
      "sockets": [
        "docs/guides/design-tooling.md"
      ]
    },
    "supabase-mcp": {
      "vendor": "Supabase",
      "serves": "data.core",
      "sockets": [
        "directives/data.md",
        "plugins/directives-toolkit/agents/supabase.md"
      ]
    },
    "session-start-hook": {
      "vendor": "Anthropic",
      "serves": "meta.delivery",
      "sockets": [
        "templates/claude-hooks/session-start.sh",
        "templates/claude-settings.json",
        "NEW-REPO-USER-INSTRUCTIONS.md"
      ]
    }
  },
  "considered": {
    "_comment": "Native capabilities evaluated by the upkeep mandate (CLAUDE.md -> Purpose) and NOT adopted wholesale. externals records what we depend on; this records what we looked at and declined, so an audit reads the verdict instead of re-deriving it. verdict: borrowed (an idea taken, the implementation stays) | rejected (does not fit) | deferred (fits, not yet done). stays = the path that keeps the job; must exist (validated).",
    "claude-md-management": {
      "vendor": "Anthropic",
      "verdict": "borrowed",
      "rationale": "Targets CLAUDE.md; /learn targets learnings.jsonl with typed, confidence-scored, budgeted entries. Its A-F quality rubric is worth borrowing into /audit-repo; the file stays.",
      "stays": "plugins/directives-toolkit/commands/learn.md"
    },
    "commit-commands": {
      "vendor": "Anthropic",
      "verdict": "rejected",
      "rationale": "Creates commits/PRs; /commit-chk verifies BEFORE a push. Complementary, not overlapping.",
      "stays": "plugins/directives-toolkit/commands/commit-chk.md"
    },
    "feature-dev": {
      "vendor": "Anthropic",
      "verdict": "rejected",
      "rationale": "Generic explore/architect/review flow; /sdd-loop is bound to the imported directives as its constitution.",
      "stays": "plugins/directives-toolkit/commands/sdd-loop.md"
    },
    "plugin-dev": {
      "vendor": "Anthropic",
      "verdict": "deferred",
      "rationale": "Vendor authoring spec for commands/agents/hooks; this repo writes them from convention. Adopt as the authoring reference for meta.session and meta.guards."
    },
    "hookify": {
      "vendor": "Anthropic",
      "verdict": "deferred",
      "rationale": "Builds hooks from markdown rules; hooks.json carries 8 hand-written shell entries where a mistyped matcher fails silently."
    },
    "skill-creator": {
      "vendor": "Anthropic",
      "verdict": "deferred",
      "rationale": "Adds evals and description tuning; the 3 auto-skills fire on description match with nothing testing that they do."
    },
    "dataviz": {
      "vendor": "Anthropic",
      "verdict": "deferred",
      "rationale": "design.md has no charting standard."
    },
    "artifact-diagramming": {
      "vendor": "Anthropic",
      "verdict": "deferred",
      "rationale": "Covers the same ground as design.md -> Diagrams & connectors, which is hand-written."
    }
  }
}
