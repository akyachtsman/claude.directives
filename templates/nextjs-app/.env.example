# Copy to .env.local for local notes, and set these in Vercel → Project →
# Settings → Environment Variables. NEVER commit real keys.

# Client-safe — exposed to the browser. RLS is the enforcement boundary.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLISHABLE-KEY

# SERVER-ONLY — bypasses RLS. Never prefix with NEXT_PUBLIC_, never import into
# client code. Set as a Vercel secret; use only in server components / route
# handlers for genuinely privileged operations. (See directives/data.md.)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
